= new Map();\n"},{"start":454,"end":516,"text":"  resolve(entry, {crateRoot = '', dependency = false, configuration = {}} = {}) {\n    this.configurations.set(crateRoot, configuration);\n"},{"start":1119,"end":1219,"text":"    try {\n      const evaluator=new Configuration(this.configurations.get(crateRoot)),state=evaluator.attributes(parsed.ast.attributes);\n      this.decisions.push(...evaluator.decisions);\n      return state.enabled?this.items(parsed.ast.items, moduleDirectory, namespace, crateRoot, dependency):[];\n    }\n"},{"start":1351,"end":1425,"text":"      const configuration=this.configurations.get(crateRoot),evaluator=new Configuration(configuration),state=evaluator.attributes(item.attributes);\n      this.decisions.push(...evaluator.decisions);if(!state.enabled)return null;\n      const result = {...item, attributes:state.attributes, configuration, module: namespace, crateRoot, dependency};\n"},{"start":1724,"end":1724,"text":"      const pathAttribute=state.attributes.find(a=>a.name==='path');\n      if(pathAttribute&&pathAttribute.meta?.valueKind!=='string')throw new Diagnostic('F_CFG','Module path must be a string',pathAttribute.span);\n      if(pathAttribute){const path=V.path(pathAttribute.meta.value,V.directory(item.span.file));\n        if(!Object.hasOwn(this.files,path))throw new Diagnostic('E0583',`Missing Rust module ${path}`,item.span);\n        this.edges.push({from:item.span.file,to:path,namespace:nextNamespace,span:item.span});\n        return {...result,external:false,file:path,items:this.file(path,V.directory(path),nextNamespace,crateRoot,dependency)};}\n"},{"start":2442,"end":2450,"text":"    }).filter(Boolean);\n"},{"start":2471,"end":2686,"text":"    return {files: [...this.records.values()].map(({file, source, tokens, cached, lexMs, parseMs}) => ({file, source, tokens, cached, lexMs: cached ? 0 : lexMs, parseMs: cached ? 0 : parseMs})), edges: this.edges, configuration: this.decisions};\n"}]},{"path":"src/ui/IdeApplication.js","before":"aa788f1e51fbb77ca66e76e0b45269b494c2436a9ecff47a0f4abb10a0dd0f53","after":"8f9e6d367a9b7836d8b0f2b20b3c3e0deb8b49eae7ba4756f64880094ace5fd6","edits":[{"start":0,"end":0,"text":"import {CargoOptions} from '../cargo/CargoOptions.js';\n"},{"start":16068,"end":16294,"text":"    const args=[...this.nativeArgs,...CargoOptions.arguments(command,this.options)];\n"}]},{"path":"src/ui/model/SampleCatalog.js","before":"b068a6d102e022b129e33ba0868c32270f9b5bef0652c02f44820c479567abf8","after":"1f9a048e74e7242740f41ec39a5b4a69dffe63786e9da7c70498056a2c0855a0","edits":[{"start":1280,"end":1280,"text":"}\n`}},\n    {name:'Conditional build · Cargo features & cfg',expected:'baseline false\\n',files:{\n      'Cargo.toml':manifest('conditional-build')+'\\n[features]\\ndefault=[]\\nfast=[]\\n',\n      'src/main.rs':`// Toggle \"fast\" in the Cargo tool window, then Run.\n#[cfg(feature = \"fast\")]\nfn mode() -> &str { \"accelerated\" }\n\n#[cfg(not(feature = \"fast\"))]\nfn mode() -> &str { \"baseline\" }\n\n#[cfg(false)]\nmod unavailable_on_this_target;\n\nfn main() {\n    println!(\"{} {}\", mode(), cfg!(feature = \"fast\"));\n"}]},{"path":"src/ui/views/CargoView.js","before":"56ea3737c110005d91920c2837d0f7e143b2c32794b7c87c5f3de4b9303b44cb","after":"0d7a1f628a01d223f0e7aa3a1f269edf70e87966ecb6cfc5ac12890bf739f183","edits":[{"start":1930,"end":2294,"text":"    packages.onchange=()=>{this.options={package:packages.value};this.onOptions(this.options);this.render();};targets.onchange=()=>{this.options={...this.options,target:targets.value,targetKind:plan.packages.find(p=>p.id===plan.selected)?.targets.find(t=>t.name===targets.value)?.kind};this.onOptions(this.options);};group.append(Dom.element('label','field-label','Package'),packages,Dom.element('label','field-label','Target'),targets);this.planRoot.append(group);this.features(plan);\n"},{"start":3558,"end":3558,"text":"  }\n  features(plan){\n    const state=plan.features?.[plan.selected];if(!state)return;\n    const panel=Dom.element('fieldset','cargo-features');panel.append(Dom.element('legend','','Feature configuration'));\n    const toggle=(title,checked,action,id)=>{\n      const label=Dom.element('label','feature-toggle'),input=Dom.element('input');input.type='checkbox';input.checked=checked;if(id)input.id=id;\n      input.onchange=()=>{action(input.checked);this.onOptions(this.options);this.render();};label.append(input,document.createTextNode(title));panel.append(label);return input;\n    };\n    toggle('Default features',this.options.defaultFeatures!==false,checked=>this.options={...this.options,defaultFeatures:checked},'cargo-default-features');\n    toggle('All features',!!this.options.allFeatures,checked=>this.options={...this.options,allFeatures:checked},'cargo-all-features');\n    for(const name of state.available??[]){\n      if(name==='default')continue;\n      const input=toggle(name,(this.options.features??[]).includes(name),checked=>{\n        const requested=new Set(this.options.features??[]);checked?requested.add(name):requested.delete(name);\n        this.options={...this.options,features:[...requested].sort()};\n      });input.dataset.feature=name;input.disabled=!!this.options.allFeatures;\n    }\n    panel.append(Dom.element('p','view-note',`Resolved: ${state.enabled.join(', ')||'(none)'}`));this.planRoot.append(panel);\n"}]},{"path":"src/ui/views/InspectorView.js","before":"3fdb07c617b5ec6d07ae83a1a36de116f32a8bb2a68148da96792fbce6086a6a","after":"ea80630a5373ca0aa237211a922039de57c20f011d205cc44bca4aed2b52cf71","edits":[{"start":4899,"end":4899,"text":"      case 'configuration':for(const item of stage.data)this.card(`${item.kind} → ${item.enabled?'included':'excluded'}`,this.predicate(item.predicate),item.span,item.enabled?'success':'warning');break;\n"},{"start":5423,"end":5423,"text":"  predicate(node){return node.kind==='word'?node.name:node.kind==='value'?`${node.name} = ${JSON.stringify(node.value)}`:`${node.name}(${node.args.map(n=>this.predicate(n)).join(', ')})`;}\n"}]},{"path":"styles/ide.css","before":"bea264b643e9848c06817861e9efafecf2a7195092e923333767531fb27adf1c","after":"25be435ff021a6d03833ff31cbc75c840f334683b5bed1ebd7a8f90e4b8a1096","edits":[{"start":20806,"end":20806,"text":"\n/* Cargo configuration is shared by the browser compiler and native toolchain. */\n.cargo-features {margin:12px 0;padding:10px;border:1px solid var(--border,#393e49);border-radius:6px;min-width:0}\n.cargo-features legend {font-size:12px;color:#b8c8df;padding:0 5px}\n.feature-toggle {display:flex;gap:8px;align-items:center;padding:4px 0;font-size:12px}\n.feature-toggle input {accent-color:#6d9bf1;margin:0}\n"}]},{"path":"tests/cargo-extended.test.js","before":"d4cb179474a1986dc7ca26c14eb3812e709c4eea7474670810acb8177dad13e9","after":"8c56f39f22b821a7438433094ada07bb2ac224ed8f871c918d7d76c6eb64fd96","edits":[{"start":1542,"end":1700,"text":"const result=compileProject({\"Cargo.toml\":'[package]\\nname=\"abc\"\\nversion=\"0.1.0\"\\n[features]\\ndefault=[\"std\"]\\nstd=[]',\"src/main.rs\":'fn main(){println!(\"ok\");}'});\n"}]},{"path":"tools/browser-acceptance.py","before":"83f6fca86eba79ed436f1233d37fe5049f39f09363a23dc5c05b96c27354b180","after":"16d62a4c82d349d100ad852e68bca5256cf3cf040202aed03edb1279cff7ce16","edits":[{"start":5280,"end":5327,"text":"                assert len(names) == 18, names\n"},{"start":5607,"end":5673,"text":"            case('all 18 compiler stage adapters render', stages)\n"},{"start":15486,"end":15486,"text":"            def cargo_configuration():\n                select_sample('Conditional build · Cargo features & cfg')\n                run_program('baseline false\\n')\n                show_tool('Cargo')\n                page.locator('input[data-feature=\"fast\"]').check()\n                page.wait_for_function('window.ferrite.getBuild()?.plan.features[\"Cargo.toml\"].enabled.includes(\"fast\")')\n                run_program('accelerated true\\n')\n                page.locator('#stage-select').select_option(label='Configuration')\n                expect(page.locator('#inspector-content')).to_contain_text('feature = \"fast\"')\n                assert page.locator('#inspector-content .source-link').count() > 0\n                page.locator('input[data-feature=\"fast\"]').uncheck()\n                page.wait_for_function('window.ferrite.getBuild() && !window.ferrite.getBuild().plan.features[\"Cargo.toml\"].enabled.includes(\"fast\")')\n                run_program('baseline false\\n')\n                select_sample('Geometry lab · traits & modules')\n            case('Cargo feature toggles update actual cfg lowering and source-linked decisions', cargo_configuration)\n\n"}]}]}