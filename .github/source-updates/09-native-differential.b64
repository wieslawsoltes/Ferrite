{"format":"ferrite-source-update-v1","message":"test(cargo): compare program stdout without Cargo build records","files":[{"path":"tools/native-smoke.mjs","before":"7e9c040696f4eb5e69198b7896ecd3cfa80ed13496e3528338801821ec2fd6d0","after":"9449d927f13c9ae65508b3f271afb4f8fdc89d3a476f104be66b81e9c6614b59","edits":[{"start":4849,"end":5032,"text":"// Compare only program stdout. JSON-mode Cargo also writes compiler records to stdout.\n    files['app/src/main.rs']=source;const actual=await run('run',{json:false,args:['--package','smoke-app']});\n    assert.equal(actual.exitCode,0,actual.stderr);assert.equal(actual.stdout,expected);"}]}]}