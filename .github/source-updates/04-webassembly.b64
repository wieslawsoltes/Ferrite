{"format":"ferrite-source-update-v1","message":"feat(wasm): compile verified MIR to actual WebAssembly with source-linked binary output","files":[{"path":"index.html","before":"27a1b5d1219c0c09a9950feaf78bea4540a37f30d9ce45233ce48f3f82a61fc0","after":"842bbd9ec6db0749c821c7e0508dd630b6bbfbf9b61044a022ce96ad32c1af3d","edits":[{"start":892,"end":1081,"text":"    <select id=\"backend-select\" aria-label=\"Compiler backend\"><option value=\"browser\">Ferrite · MIR / JavaScript</option><option value=\"wasm\">WebAssembly · checked host ABI</option><option value=\"native\">Native · installed Cargo</option></select>\n"}]},{"path":"src/engine.js","before":"2fa37158e8672663a4a720489060345db040ca9ae608e90ef0953d1d715b1cea","after":"ea7130deacae57d5452ef359ac41b61af3ecb2ca4919bfcff56f78a20f463031","edits":[{"start":0,"end":0,"text":"import {WebAssemblyEmitter} from './compiler/wasm/WebAssemblyEmitter.js';\n"},{"start":2613,"end":2613,"text":"  const wasm = pass('Emit WebAssembly', () => new WebAssemblyEmitter(optimized.functions, {entry: semantic.entry ?? null}).build());\n  // Plain byte arrays keep cached artifacts deeply immutable and structured-cloneable.\n  wasm.bytes = Array.from(wasm.bytes);\n"},{"start":3069,"end":3205,"text":"  return {version: '0.8.0', wasm, configuration:configured.decisions, tokens, ast, expanded: expansion.ast, expansions: expansion.expansions,\n"}]},{"path":"src/project/CompilerSession.js","before":"428d9b01c68e06c10504c612bb7806112fb34b3b3a0b69ee5211ef60bd45390a","after":"a1594fd51ffa2c25dff6ef1df4e10dc68330ab0826db7025aa7f243863403031","edits":[{"start":7293,"end":7293,"text":"      {name: 'WebAssembly', kind:'wasm',data:compilation.wasm},\n"}]},{"path":"src/ui/IdeApplication.js","before":"8f9e6d367a9b7836d8b0f2b20b3c3e0deb8b49eae7ba4756f64880094ace5fd6","after":"9d1ffe39e529428254e07fbf8033a1b795e6b3b2a18775030f6ecf3aceec46a2","edits":[{"start":14463,"end":14785,"text":"      if(command==='build'&&this.backend==='wasm'){this.download('ferrite.wasm',new Uint8Array(this.build.wasm.bytes),'application/wasm');this.writeOutput('Build succeeded. Real WebAssembly downloaded. This module requires the Ferrite checked host ABI (WebAssemblyRuntime); it is not a WASI executable.');}\n      else if(command==='build'){this.download('ferrite-generated.mjs',`const postMessage = text => process.stdout.write(String(text));\\n${this.build.js}`,'text/javascript');this.writeOutput('Build succeeded. Generated JavaScript downloaded as ferrite-generated.mjs.\\nRun with Node.js 20+; this is not a native executable.');}\n"},{"start":14842,"end":14987,"text":"        this.runMode=command;this.writeOutput('');this.runLabel.textContent=command==='debug'?'Executable MIR debugger':this.backend==='wasm'?'WebAssembly execution · checked host ABI':'Ferrite MIR execution';\n"},{"start":15295,"end":15371,"text":"        this.execution.start(this.build,command,this.model.breakpointList,this.backend);\n"},{"start":18535,"end":18743,"text":"      else{this.writeOutput(event.state.output);this.runLabel.textContent=`Process finished · ${event.state.steps.toLocaleString()} ${event.state.backend==='wasm'?'WebAssembly-lowered':'MIR'} instructions`;this.status('Process finished successfully','success');}\n"}]},{"path":"src/ui/services/ExecutionService.js","before":"036188ad80c0efeb9a2c5974036472f713ac170d3c1b07c0b5c8623ce793981d","after":"b2b4371f3fe3ba0665b36dfd424879553ec749777d5266c675fbabbe156aead4","edits":[{"start":206,"end":247,"text":"  start(build, mode, breakpoints = [], backend = 'browser') {\n"},{"start":812,"end":951,"text":"    this.worker.postMessage({command: 'start', functions: build.optimizedMir, entry: build.entry, tests: build.tests, mode, breakpoints, backend, wasm: backend==='wasm'?build.wasm:null});\n"}]},{"path":"src/ui/views/InspectorView.js","before":"a89b4cafef49def56b9e136508de75ce718a8316dc8e8b5bdb1cd23addf1d65e","after":"dad835042110f0a3c6b638c82136192d2bb596b85a655be0a05baa30342600cb","edits":[{"start":0,"end":0,"text":"import {WebAssemblyView} from './WebAssemblyView.js';\n"},{"start":3955,"end":3955,"text":"      case 'wasm':new WebAssemblyView(this.content,this.registry).render(stage.data);break;\n"}]},{"path":"src/ui/workers/execution-worker.js","before":"0345a2bae58ee42992d2a34bd799a6091a956d3e8730e96024d395ae56f9ea70","after":"48f0ee788264a78edc2f93e53a721609e88cd2a7a15b78a6db216ce9692fcac5","edits":[{"start":0,"end":0,"text":"import {WebAssemblyRuntime} from '../../runtime/WebAssemblyRuntime.js';\n"},{"start":2303,"end":2303,"text":"      if(data.backend==='wasm'&&data.mode==='run'){const wasm=new WebAssemblyRuntime(data.wasm,options),state=wasm.run({entry:data.entry});postMessage({type:'done',state:{...state,backend:'wasm',frames:[]}});return;}\n      if(data.backend==='wasm'&&data.mode==='test'){\n        const results=[];for(const test of data.tests??[]){let status=test.ignore?'ignored':'passed',caught=null;\n          if(!test.ignore){try{new WebAssemblyRuntime(data.wasm,options).run({entry:test.instance});}catch(error){caught=error;}\n            if(!!caught!==!!test.shouldPanic||['R_BUDGET','R_STACK'].includes(caught?.code))status='failed';}\n          const result={...test,status,message:status==='failed'?caught?.message??'Expected panic did not occur':''};results.push(result);postMessage({type:'test',result});\n        }postMessage({type:'tests-done',results});return;\n      }\n"}]},{"path":"styles/ide.css","before":"25be435ff021a6d03833ff31cbc75c840f334683b5bed1ebd7a8f90e4b8a1096","after":"6e9ed158b7d69808e59338c4d3ab20cc4456557ecdb5dce8208f5659a80239ae","edits":[{"start":21212,"end":21212,"text":"\n.wasm-magic{display:block;margin-top:8px;color:#b5cbf5}.wasm-export{display:block;width:100%;text-align:left}\n.wasm-instructions{table-layout:fixed}.wasm-instructions th:first-child{width:75px}.wasm-instructions th:nth-child(2){width:100px}\n.wasm-hex{word-break:break-all;font:11px/1.7 ui-monospace,monospace;color:#93b9dd}.wasm-imports{margin-top:12px;padding:8px;background:var(--panel)}\n"}]},{"path":"tools/browser-acceptance.py","before":"9f9d41b87533a92a94f9734b22060d255e9f5b6b0ff986baaeab6fb6e7f6c62a","after":"654dc7fd20a78c5c271a409e3375a57f3922acb53a66ad356c6fd47df09b199d","edits":[{"start":5280,"end":5327,"text":"                assert len(names) == 20, names\n"},{"start":5607,"end":5673,"text":"            case('all 20 compiler stage adapters render', stages)\n"},{"start":15486,"end":15486,"text":"            def wasm_execution():\n                select_sample('Closures · capture modes & call traits')\n                page.locator('#backend-select').select_option('wasm')\n                run_program('scaled 42\\nstate 2 3\\nowned payload\\n')\n                expect(page.locator('.run-header')).to_contain_text('WebAssembly-lowered')\n                page.locator('#stage-select').select_option(label='WebAssembly')\n                expect(page.locator('#inspector-content')).to_contain_text('00 61 73 6d 01 00 00 00')\n                page.locator('.wasm-instructions .source-link').first.click()\n                start, end = page.locator('#source').evaluate('e=>[e.selectionStart,e.selectionEnd]')\n                assert end > start\n                select_sample('Geometry lab · traits & modules')\n            case('real WebAssembly executes capturing closures and maps binary offsets to source', wasm_execution)\n\n"}]}]}