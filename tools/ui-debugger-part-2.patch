+        this.ready = true;
+        for (const [id, task] of this.pending) if (id.startsWith('ready:') && task.channel === this.channel) { this.pending.delete(id); clearTimeout(task.timer); task.signal?.removeEventListener('abort', task.abort); task.resolve(); }
+      }
